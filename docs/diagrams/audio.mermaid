classDiagram
    class VariacionSfx {
        <<static, POCO>>
        +PitchMinimo
        +SinClip
        +Volumen(volumenBase, variacion, aleatorio01) float
        +Pitch(pitchBase, variacion, aleatorio01) float
        +IndiceClip(cantidad, anterior, aleatorio01) int
    }

    class SeleccionVozSfx {
        <<static, POCO>>
        +CrearNueva
        +Elegir(ocupadas, inicios, maximo) int
    }

    class SfxPorIndice {
        <<static, POCO>>
        +SinSfx
        +Elegir(indice, cantidad) int
    }

    class SfxCombate {
        <<MonoBehaviour>>
        -SfxBanco _ataqueNormal
        -SfxBanco[] _golpesCombo
        -SfxBanco _disparo
        -SfxBanco _cargaLoop
        -SfxBanco _liberacionCargado
        +Golpe(comboIndex)
        +Disparo(origen)
        +Carga(activa)
        +LiberacionCargado()
    }

    class SfxLocomocion {
        <<MonoBehaviour>>
        -SfxBanco _dash
        -SfxBanco _gancho
        -SfxBanco _dobleSalto
        -SfxBanco _embestidaArranque
        -SfxBanco _embestidaAvance
        -SfxBanco _embestidaFinal
        +Dash()
        +Gancho()
        +DobleSalto()
        +EmbestidaInicio()
        +ActualizarEmbestida(activa)
    }

    class Proyectil {
        <<NetworkBehaviour>>
        -SfxBanco _sfxImpactoAmbiente
        -SfxBanco _sfxImpactoJefe
        -ReproducirSfxImpacto(punto, enJefe)
    }

    class AnchorLauncher {
        <<NetworkBehaviour>>
        -SfxBanco _sfxLanzamiento
        -ReproducirSfxLanzamiento(origen)
    }

    class DetectorFlancoSfx {
        <<POCO>>
        +Actualizar(activo) bool
    }

    class AtaqueArekBase {
        <<NetworkBehaviour, abstract>>
        #SfxJefe SfxRed
        #ReproducirSfxEnJefe(banco)
        #ReproducirSfxEn(banco, punto)
        #DetenerSfxJefe(banco)
    }

    class AtaqueMano {
        -SfxBanco _sfxAviso
        -SfxBanco _sfxGolpe
    }

    class AtaqueTentaculo {
        -SfxBanco _sfxAviso
        -SfxBanco _sfxAzote
        -ZonaDelGolpe() Vector3
    }

    class AtaqueMortero {
        -SfxBanco _sfxLanzamiento
        -SfxBanco _sfxCaida
        -ReproducirSfxLanzamiento()
        -ReproducirSfxCaida()
    }

    class AtaqueRayo {
        -SfxBanco _sfxCarga
    }

    class SubidaIntensidadSfx {
        <<static, POCO>>
        +Factor(tiempo, duracion) float
        +Interpolar(inicial, final, factor) float
    }

    class SfxBanco {
        <<ScriptableObject>>
        +clips
        +volumen, variacionVolumen
        +pitch, variacionPitch
        +retraso
        +loop
        +duracionSubida, volumenInicialSubida, pitchInicialSubida
        +mezcla3D, distanciaMinima, distanciaMaxima, atenuacion
        +maximoVoces
    }

    class SfxCatalogo {
        <<ScriptableObject>>
        +bancos
    }

    class AudioManager {
        <<Singleton>>
        -SfxCatalogo _sfxCatalogo
        -AudioMixerGroup _sfxGroup
        +Play(soundName)
        +IndiceSfx(banco) int
        +SfxPorIndice(indice) SfxBanco
        +ReproducirSfx(banco, posicion, seguir, emisor)
        +DetenerSfx(banco, emisor)
        +SetVolume(channel, linear)
    }

    class VocesSfx3D {
        +Reproducir(banco, posicion, seguir, emisor)
        +Detener(banco, emisor)
        +Actualizar()
    }

    class SfxRed {
        <<NetworkBehaviour>>
        +Reproducir(banco, posicion)
        +ReproducirEnEmisor(banco)
        +Detener(banco)
        -PedirReproducirSfxRpc() SendTo.Server
        -ReproducirSfxRpc() SendTo.ClientsAndHost
        -PedirDetenerSfxRpc() SendTo.Server
        -DetenerSfxRpc() SendTo.ClientsAndHost
    }

    class SfxAnimacion {
        <<MonoBehaviour>>
        +ReproducirSfx(banco)
        +DetenerSfx(banco)
    }

    SfxCatalogo o-- SfxBanco
    AudioManager --> SfxCatalogo
    AudioManager *-- VocesSfx3D
    VocesSfx3D ..> VariacionSfx
    VocesSfx3D ..> SeleccionVozSfx
    VocesSfx3D ..> SfxBanco
    SfxRed ..> AudioManager : indice del banco en el catalogo
    SfxAnimacion --> SfxRed : evento de animacion, solo el owner
    PlayerCombat --> SfxCombate : golpe del combo, solo el owner
    SfxCombate ..> SfxPorIndice
    SfxCombate --> SfxRed
    VocesSfx3D ..> SubidaIntensidadSfx
    PlayerRoot --> SfxLocomocion : eventos de locomocion, solo el owner
    SfxLocomocion --> SfxRed
    Proyectil --> SfxRed : impacto, lo lanza el servidor
    SfxLocomocion ..> DetectorFinEmbestida
    AnchorLauncher --> SfxRed : lanzamiento validado en el servidor
    AtaqueArekBase <|-- AtaqueMano
    AtaqueArekBase --> SfxRed : SfxRed de la raiz de AREK, solo el servidor
    AtaqueMano ..> DetectorFlancoSfx
    AtaqueArekBase <|-- AtaqueTentaculo
    AtaqueArekBase <|-- AtaqueMortero
    AtaqueArekBase <|-- AtaqueRayo
