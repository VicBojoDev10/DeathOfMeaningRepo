flowchart TD
    Player["Player: PlayerAyla / PlayerZendre (NetworkObject, ClientNetworkTransform, CharacterController, CapsuleCollider)"]
    Player --> Root[PlayerRoot - composition root]
    Player --> Motor[PlayerMotor]
    Player --> Reader[PlayerInputReader]
    Player --> Combat[PlayerCombat]
    Player --> CombatAnim[PlayerCombatAnimator]
    Player --> LocoAnim["AylaPlayerLocomotionAnimator / ZendrePlayerLocomotionAnimator"]
    Player --> Grapple["GrappleVisual + LineRenderer (Ayla)"]
    Player --> Anchor["AnchorLauncher (Zendre)"]
    Player --> HitboxOrigin["HitboxOrigin - HitboxCaster"]
    HitboxOrigin --> Vfx[CombatVfx]
    Player --> HurtBox["HurtBox - CapsuleCollider"]
    Player --> Pivot["CameraPivot - CinemachineCamera, CinemachineImpulseSource, PlayerCameraRig, FeedbackDirector"]
    Pivot --> VM["Viewmodel - ViewmodelRig"]
    Player --> Modelo["Modelo: AylaModel / ZendreModel"]
    Root --> Motor
    Root --> Reader
    Root --> Pivot
    Root --> Grapple
    Root -->|GetComponentInChildren| Combat
    Root -->|GetComponentInChildren| Anchor
    Root -->|"Instantiate solo dueno"| Hud["HudEnergia - PlayerEnergyHud"]
    Combat -->|animacion local| CombatAnim
    Combat -.->|"ReproducirGolpeRpc (RPC NotOwner)"| AnimRemoto["PlayerCombatAnimator del otro cliente"]
    Cinematic[CinematicDirector] -->|"SetControlCinematica, SetCamaraCedida"| Root
    Root -->|SetEntradaHabilitada| Reader
    Root -->|CederPrioridad| Pivot
