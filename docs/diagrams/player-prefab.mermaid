flowchart TD
    Player["Player: PlayerAyla / PlayerZendre (NetworkObject, ClientNetworkTransform, CharacterController, CapsuleCollider)"]
    Player --> Root[PlayerRoot - composition root]
    Player --> Motor[PlayerMotor]
    Player --> Reader[PlayerInputReader]
    Player --> Combat[PlayerCombat]
    Player --> CombatAnim[PlayerCombatAnimator]
    Player --> LocoAnim["AylaPlayerLocomotionAnimator / ZendrePlayerLocomotionAnimator"]
    Player --> Grapple["GrappleVisual + LineRenderer (Ayla)"]
    Player --> Anchor["AnchorLauncher (Zendre)"]
    Player --> HitboxOrigin["HitboxOrigin - HitboxCaster"]
    HitboxOrigin --> Vfx[CombatVfx]
    Player --> HurtBox["HurtBox - CapsuleCollider"]
    Player --> Pivot["CameraPivot - CinemachineImpulseSource, PlayerCameraRig, FeedbackDirector"]
    Pivot --> TPC["ThirdPersonCamera - CinemachineCamera, CinemachineThirdPersonFollow, CinemachineImpulseListener"]
    Pivot --> VM["Viewmodel - ViewmodelRig (inactivo)"]
    Player --> Modelo["Modelo: AylaModel / ZendreModel"]
    Root --> Motor
    Root --> Reader
    Root -->|"ApplyLook, ActualizarEncuadre"| Pivot
    Root --> Facing["FacingResolver: giro del root hacia el movimiento"]
    Root -->|"LockOnPressed (R3)"| LockOn["LockOnResolver: fija yaw y pitch hacia el objetivo"]
    LockOn -.->|"LockOnTarget.Activos"| Objetivo["LockOnTarget en los 12 ojos de BossArek y en MinionArek (al morir el minion se libera al despawnear)"]
    Root -->|"Stick derecho con objetivo fijado"| Cambio["LockOnSwitcher: cambia al objetivo en esa dirección (LockOnResolver.FijarA)"]
    Pivot --> Config["ThirdPersonCameraConfig (valores por stance)"]
    Pivot --> Stances["CameraStanceResolver: Exploracion, Sprint, Combate, Apuntado"]
    Root -->|"RegistrarDesplazamientoLateral (dash o carga lateral en combate)"| Pivot
    Combat -->|"ResolverApuntado (AimResolver)"| Root
    Anchor -->|"ResolverApuntado (AimResolver)"| Root
    Root --> Grapple
    Root -->|GetComponentInChildren| Combat
    Root -->|GetComponentInChildren| Anchor
    Root -->|"Instantiate solo dueno"| Hud["HudEnergia - PlayerEnergyHud"]
    Combat -->|animacion local| CombatAnim
    Combat -.->|"ReproducirGolpeRpc (RPC NotOwner)"| AnimRemoto["PlayerCombatAnimator del otro cliente"]
    Cinematic[CinematicDirector] -->|"SetControlCinematica, SetCamaraCedida"| Root
    Root -->|SetEntradaHabilitada| Reader
    Root -->|CederPrioridad| Pivot
