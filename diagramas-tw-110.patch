 ## Nomenclatura
 
diff --git a/docs/diagrams/boss.mermaid b/docs/diagrams/boss.mermaid
new file mode 100644
index 0000000..495c545
--- /dev/null
+++ b/docs/diagrams/boss.mermaid
@@ -0,0 +1,22 @@
+flowchart TD
+    GSM[GameSessionManager servidor] -->|"Instantiate + Spawn al iniciar la partida"| BC["BossArek: BossController"]
+    BC --> PSM["BossPhaseStateMachine (BossPhaseProfile)"]
+    BC --> SCH[BossAttackScheduler]
+    SCH -->|Telegraph| AA[AtaquesArek.Lanzar]
+    AA -->|Basico| MANO[AtaqueMano]
+    AA -->|Especial| RAYO[AtaqueRayo]
+    AA -->|InstaKill| MORT[AtaqueMortero]
+    AA -.->|"Pesado: Tentaculo pendiente"| TENT[Sin implementar]
+    SCH -->|"Telegraph / Impacto: TelegraphAtaqueRpc, ImpactoAtaqueRpc (ClientsAndHost)"| CLI[Clientes]
+    MANO -->|"AvisoRpc (ClientsAndHost)"| CLI
+    RAYO -->|"AvisoRpc, RayoRpc, ApagarRpc (ClientsAndHost)"| CLI
+    MORT -->|"AvisoRpc, CaidaRpc (ClientsAndHost)"| CLI
+    MANO -->|"JugadorGolpeadoRpc (SpecifiedInParams)"| HIT[Jugador golpeado]
+    RAYO -->|"JugadorGolpeadoRpc (SpecifiedInParams)"| HIT
+    MORT -->|"JugadorGolpeadoRpc (SpecifiedInParams)"| HIT
+    HZ["HitZone x12: ojos"] -->|"DanioAcumulado (NetworkVariable)"| BC
+    BC -->|AplicarDano| PSM
+    PSM -->|cambio de fase| FASE["Fase (NetworkVariable)"]
+    FASE -->|OnFaseChanged| CD[CinematicDirector]
+    BC -->|"Spawned (evento estatico)"| CD
+    CD -->|"Pausar: detiene el scheduler"| BC
diff --git a/docs/diagrams/cinematic-flow.mermaid b/docs/diagrams/cinematic-flow.mermaid
new file mode 100644
index 0000000..445f97f
--- /dev/null
+++ b/docs/diagrams/cinematic-flow.mermaid
@@ -0,0 +1,16 @@
+flowchart TD
+    BTN["Boton debug: Probar cinematica (host)"] --> REP
+    FASE["BossController.OnFaseChanged con _reproducirEnCambioDeFase"] -->|"id fase_n"| REP
+    REP["CinematicDirector.Reproducir (solo servidor, desde Gameplay)"] -->|"ReproducirRpc (ClientsAndHost)"| INI
+    subgraph CADA["En el host y en cada cliente"]
+        INI[GameFlowStateMachine.IniciarCinematica] --> CIN[Estado Cinematica]
+        CIN --> CTRL["Sin input ni HUD: PlayerRoot.SetControlCinematica, GameplayUI.SetHudVisible"]
+        CIN --> ENT["Fade a negro, PlayerCameraRig.CederPrioridad, PlayableDirector.Play, fade de vuelta"]
+        TRA[Estado Transicion] --> SAL["Fade a negro, PlayableDirector.Stop, recupera camara, fade de vuelta"]
+        TRA -->|"Tick: dura 2 x duracion del fade"| GP[Estado Gameplay]
+        GP --> VUELTA[Regresan input y HUD]
+    end
+    ENT -->|"servidor: el Timeline llega al final"| FIN["TerminarRpc (ClientsAndHost)"]
+    FIN -->|TerminarCinematica| TRA
+    CIN -.->|"servidor: Pausar(true)"| BOSS[BossController]
+    GP -.->|"servidor: Pausar(false)"| BOSS
diff --git a/docs/diagrams/combat.mermaid b/docs/diagrams/combat.mermaid
index 4021780..02e3c0d 100644
--- a/docs/diagrams/combat.mermaid
+++ b/docs/diagrams/combat.mermaid
@@ -1,6 +1,24 @@
-﻿flowchart LR
-    IN[InputSnapshot] --> CSM[ComboStateMachine]
-    BUF[InputBuffer] --> CSM
-    CSM -->|AttackEvent| PC[PlayerCombat]
-    PC -->|RPC servidor| SRV[Validacion + dano WIP]
-    PC -->|RPC NotOwner| ANIM[Animator del otro cliente]
+﻿flowchart TD
+    IN[InputSnapshot] --> PC["PlayerCombat.Tick (solo dueno)"]
+    PC --> MEL["ComboStateMachine melee + InputBuffer"]
+    PC --> RNG["ComboStateMachine disparo + InputBuffer"]
+    MEL -->|AttackEvent| GOLPE[Golpe melee]
+    RNG -->|AttackEvent| DISP[Disparo]
+    GOLPE -->|"cargado: ConsumirEnergiaRpc (Server)"| EN["PlayerRoot.ConsumirEnergiaEnServidor: EnergyPool"]
+    DISP -->|"cargado: ConsumirEnergiaRpc (Server)"| EN
+    GOLPE --> HB[HitboxCaster.DetectarImpactos]
+    HB -->|"ReportarGolpeRpc (Server)"| VAL[Servidor valida el rango]
+    DISP -->|"con prefab: DispararRpc (Server)"| PROY[Proyectil spawneado en el servidor]
+    DISP -->|"sin prefab: DetectarDisparo + ReportarDisparoRpc (Server)"| VAL
+    VAL --> HZ[HitZone.RegistrarDanio]
+    PROY --> HZ
+    HZ -->|"DanioAcumulado (NetworkVariable)"| BOSS[BossController]
+    GOLPE --> LOCAL["Local: PlayerCombatAnimator, CombatVfx, FeedbackDirector"]
+    DISP --> LOCAL
+    PC -.->|"ReproducirGolpeRpc, ReproducirDisparoRpc, CargaRpc (NotOwner)"| REM[Animator y VFX del otro cliente]
+    PC -->|AtaqueActivo bloquea la locomocion| ROOT[PlayerRoot]
+    INZ["InputSnapshot: AimHeld + GrappleHeld (Zendre)"] --> AL["AnchorLauncher + CooldownTimer"]
+    AL -->|"LanzarAnclaRpc (Server)"| AN[Ancla spawneada en el servidor]
+    AL -->|"SoltarAnclaRpc (Server)"| AN
+    AN -.->|"RechazarLanzamientoRpc (Owner)"| AL
+    AN -->|"Pegada (NetworkVariable)"| ROOT
diff --git a/docs/diagrams/locomotion.mermaid b/docs/diagrams/locomotion.mermaid
index a10d2af..6616d3a 100644
--- a/docs/diagrams/locomotion.mermaid
